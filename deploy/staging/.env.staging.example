# ==============================================================================
# NEU LMS — Staging Environment Variables Template
# Copy this file to .env.staging and populate with real, secret staging credentials.
# NEVER commit .env.staging or real credentials into version control.
# ==============================================================================

# 1. Django Core Configuration
# Production settings module is mandatory for staging to enforce HTTPS, HSTS, and strict cookies.
DJANGO_SETTINGS_MODULE=config.settings.production

# Strong, high-entropy secret key (min 50 characters, at least 5 distinct chars, no 'dev-' prefix).
DJANGO_SECRET_KEY=replace-with-cryptographically-secure-random-key-at-least-50-chars-long

# Explicit comma-separated allowed hosts (wildcards '*' are strictly prohibited in production settings).
DJANGO_ALLOWED_HOSTS=staging.lms.neu.edu.vn,api.staging.lms.neu.edu.vn,127.0.0.1

# CSRF trusted origins for browser API clients (DJANG_CSRF_TRUSTED_ORIGINS is the canonical setting).
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.lms.neu.edu.vn
CSRF_TRUSTED_ORIGINS=https://staging.lms.neu.edu.vn

# Environment identifier (staging / production).
ENVIRONMENT=staging

# 2. Managed Database Configuration (PostgreSQL 17)
# Must connect to managed cloud database via internal VPC endpoint.
PGHOST=staging-db.internal.vpc
PGPORT=5432
PGDATABASE=neu_lms_staging
PGUSER=neu_lms_app_user
PGPASSWORD=replace-with-secure-managed-db-password

# TLS Certificate Verification:
# 'verify-full' is required by config.settings.production to prevent MITM attacks.
PGSSLMODE=verify-full
# Path to the CA certificate on the host to be mounted into containers (migrator & api):
PGSSLROOTCERT_FILE=./certs/db-ca.crt
# Path inside the container (mounted via compose volume mount to /etc/ssl/certs/db-ca.crt):
PGSSLROOTCERT=/etc/ssl/certs/db-ca.crt

# 3. Managed Cache & Broker (Redis 7.4)
# TLS-enabled Redis connection URL via internal VPC.
REDIS_URL=rediss://:replace-with-redis-auth-token@staging-redis.internal.vpc:6379/0

# 4. Container & Ingress Configuration
# Immutable image digest produced by CI build for the specific Git commit SHA (never use mutable tags in staging/production).
# Format: ghcr.io/<org>/<repo>@sha256:<64_hex_digits>
API_IMAGE=ghcr.io/neu-lms/api@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
API_PORT=8000

# Trusted Reverse Proxy Ingress (e.g. AWS ALB, Traefik, Cloudflare, Nginx terminating SSL):
# When set to true, Django trusts X-Forwarded-Proto: https from ingress.
DJANGO_BEHIND_TRUSTED_PROXY=true

# 5. Planned Components (To be configured in B08/B13):
# - S3 / Object Storage: AWS_S3_ENDPOINT_URL, AWS_S3_BUCKET_NAME, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# - Transactional Email: EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, DEFAULT_FROM_EMAIL
# Local mock services (S3Mock, Mailpit) are NEVER used in staging.

# B03: set the actual HTTPS frontend origin; do not use localhost
PUBLIC_APP_ORIGIN=https://staging.example.org
DEFAULT_FROM_EMAIL=noreply@staging.example.org
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-provider-user
EMAIL_HOST_PASSWORD=replace-with-provider-secret
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
