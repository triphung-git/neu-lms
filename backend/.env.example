# Local example only. Copy to .env, which is ignored by Git.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-local-example-key-replace-for-shared-environments
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PGDATABASE=neu_lms
PGUSER=neu_lms
PGPASSWORD=local-postgres-example-password
PGHOST=127.0.0.1
PGPORT=55432
PGSSLMODE=disable
