{
    "openapi": "3.0.3",
    "info": {
        "title": "NEU LMS API",
        "version": "1.0.0",
        "description": "Hợp đồng API chuẩn của nền tảng NEU LMS"
    },
    "paths": {
        "/api/v1/auth/csrf": {
            "get": {
                "operationId": "auth_csrf_retrieve",
                "tags": [
                    "auth"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "operationId": "auth_login_create",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CredentialsRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/CredentialsRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/CredentialsRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SessionInfo"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "operationId": "auth_logout_create",
                "tags": [
                    "auth"
                ],
                "security": [
                    {
                        "SessionCookieAuth": [],
                        "CSRFToken": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/v1/auth/logout-all": {
            "post": {
                "operationId": "auth_logout_all_create",
                "tags": [
                    "auth"
                ],
                "security": [
                    {
                        "SessionCookieAuth": [],
                        "CSRFToken": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/v1/auth/me": {
            "get": {
                "operationId": "auth_me_retrieve",
                "tags": [
                    "auth"
                ],
                "security": [
                    {
                        "SessionCookieAuth": [],
                        "CSRFToken": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SessionInfo"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/auth/password/change": {
            "post": {
                "operationId": "auth_password_change_create",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordChangeRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordChangeRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordChangeRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "SessionCookieAuth": [],
                        "CSRFToken": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/v1/auth/password/request-reset": {
            "post": {
                "operationId": "auth_password_request_reset_create",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResetRequestRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/ResetRequestRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/ResetRequestRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {}
                ],
                "responses": {
                    "202": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/v1/auth/password/reset": {
            "post": {
                "operationId": "auth_password_reset_create",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResetConfirmRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/ResetConfirmRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/ResetConfirmRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {}
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/v1/courses": {
            "get": {
                "operationId": "courses_list",
                "parameters": [
                    {
                        "name": "page",
                        "required": false,
                        "in": "query",
                        "description": "A page number within the paginated result set.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "page_size",
                        "required": false,
                        "in": "query",
                        "description": "Number of results to return per page.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "tags": [
                    "courses"
                ],
                "security": [
                    {
                        "SessionCookieAuth": [],
                        "CSRFToken": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaginatedCourseList"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "post": {
                "operationId": "courses_create",
                "tags": [
                    "courses"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CourseRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/CourseRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/CourseRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "SessionCookieAuth": [],
                        "CSRFToken": []
                    }
                ],
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Course"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/courses/{id}": {
            "get": {
                "operationId": "courses_retrieve",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "description": "A UUID string identifying this course.",
                        "required": true
                    }
                ],
                "tags": [
                    "courses"
                ],
                "security": [
                    {
                        "SessionCookieAuth": [],
                        "CSRFToken": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Course"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/health/live": {
            "get": {
                "operationId": "get_health_live",
                "description": "Trả về 200 khi container API đang chạy, không kiểm tra phụ thuộc bên ngoài.",
                "summary": "Kiểm tra trạng thái hoạt động (Liveness)",
                "tags": [
                    "health"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LivenessResponse"
                                }
                            }
                        },
                        "description": "API container đang hoạt động."
                    }
                }
            }
        },
        "/api/v1/health/ready": {
            "get": {
                "operationId": "get_health_ready",
                "description": "Kiểm tra kết nối cơ sở dữ liệu PostgreSQL. Trả về 200 nếu sẵn sàng, 503 nếu DB gián đoạn.",
                "summary": "Kiểm tra trạng thái sẵn sàng (Readiness)",
                "tags": [
                    "health"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ReadinessSuccessResponse"
                                }
                            }
                        },
                        "description": "Hệ thống sẵn sàng phục vụ yêu cầu."
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ReadinessUnavailableResponse"
                                }
                            }
                        },
                        "description": "Cơ sở dữ liệu không khả dụng."
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Course": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "code": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 200
                    },
                    "term": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "description": {
                        "type": "string"
                    },
                    "teacher": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "teacher_name": {
                        "type": "string",
                        "readOnly": true
                    },
                    "status": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/StatusEnum"
                            }
                        ],
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "code",
                    "created_at",
                    "id",
                    "name",
                    "status",
                    "teacher",
                    "teacher_name",
                    "term",
                    "updated_at"
                ]
            },
            "CourseRequest": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "term": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [
                    "code",
                    "name",
                    "term"
                ]
            },
            "CredentialsRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1,
                        "maxLength": 254
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1,
                        "maxLength": 1024
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "ErrorEnvelope": {
                "type": "object",
                "required": [
                    "error"
                ],
                "properties": {
                    "error": {
                        "type": "object",
                        "required": [
                            "code",
                            "message",
                            "request_id",
                            "correlation_id"
                        ],
                        "properties": {
                            "code": {
                                "type": "string",
                                "description": "Mã lỗi định danh máy (machine-readable)",
                                "example": "validation_error"
                            },
                            "message": {
                                "type": "string",
                                "description": "Thông báo lỗi an toàn bằng tiếng Việt",
                                "example": "Dữ liệu yêu cầu không hợp lệ."
                            },
                            "details": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "field": {
                                            "type": "string"
                                        },
                                        "message": {
                                            "type": "string"
                                        },
                                        "code": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "nullable": true
                            },
                            "request_id": {
                                "type": "string",
                                "format": "uuid",
                                "description": "Correlation / Request UUID"
                            },
                            "correlation_id": {
                                "type": "string",
                                "format": "uuid",
                                "description": "Correlation / Request UUID"
                            }
                        }
                    }
                }
            },
            "LivenessResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "default": "ok"
                    }
                }
            },
            "PaginatedCourseList": {
                "type": "object",
                "required": [
                    "items",
                    "pagination"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Course"
                        }
                    },
                    "pagination": {
                        "type": "object",
                        "required": [
                            "page",
                            "page_size",
                            "total_items",
                            "total_pages",
                            "has_next",
                            "has_previous"
                        ],
                        "properties": {
                            "page": {
                                "type": "integer",
                                "example": 1
                            },
                            "page_size": {
                                "type": "integer",
                                "example": 20
                            },
                            "total_items": {
                                "type": "integer",
                                "example": 100
                            },
                            "total_pages": {
                                "type": "integer",
                                "example": 5
                            },
                            "has_next": {
                                "type": "boolean",
                                "example": true
                            },
                            "has_previous": {
                                "type": "boolean",
                                "example": false
                            }
                        }
                    }
                }
            },
            "PasswordChangeRequest": {
                "type": "object",
                "properties": {
                    "current_password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1,
                        "maxLength": 1024
                    },
                    "new_password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1,
                        "maxLength": 1024
                    }
                },
                "required": [
                    "current_password",
                    "new_password"
                ]
            },
            "ReadinessSuccessResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "default": "ok"
                    },
                    "checks": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "checks"
                ]
            },
            "ReadinessUnavailableResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "default": "unavailable"
                    },
                    "checks": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "checks"
                ]
            },
            "ResetConfirmRequest": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "new_password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1,
                        "maxLength": 1024
                    }
                },
                "required": [
                    "new_password",
                    "token"
                ]
            },
            "ResetRequestRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1,
                        "maxLength": 254
                    }
                },
                "required": [
                    "email"
                ]
            },
            "RolesEnum": {
                "enum": [
                    "student",
                    "teacher",
                    "admin"
                ],
                "type": "string",
                "description": "* `student` - student\n* `teacher` - teacher\n* `admin` - admin"
            },
            "SessionInfo": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "roles": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/RolesEnum"
                        }
                    },
                    "idle_expires_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "absolute_expires_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "absolute_expires_at",
                    "display_name",
                    "email",
                    "id",
                    "idle_expires_at",
                    "roles"
                ]
            },
            "StatusEnum": {
                "enum": [
                    "open",
                    "archived"
                ],
                "type": "string",
                "description": "* `open` - Đang mở\n* `archived` - Đã lưu trữ"
            }
        },
        "securitySchemes": {
            "CSRFToken": {
                "type": "apiKey",
                "in": "header",
                "name": "X-CSRFToken",
                "description": "Token CSRF bắt buộc cho các thao tác thay đổi dữ liệu (POST, PUT, PATCH, DELETE)."
            },
            "SessionCookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "sessionid",
                "description": "Session cookie được quản lý bởi máy chủ trong UserSession store."
            }
        }
    }
}