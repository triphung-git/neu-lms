# LOCAL DEVELOPMENT ONLY; copy to .env. Never use these example values in production.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-local-example-key-replace-for-shared-environments
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PGDATABASE=neu_lms
PGUSER=neu_lms
PGPASSWORD=local-postgres-example-password
PGHOST=127.0.0.1
PGPORT=55432
PGSSLMODE=disable
API_PORT=8000
POSTGRES_PORT=55432
REDIS_PORT=56379
S3_PORT=59090
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025

# B03 authentication email; localhost must match browser origin
PUBLIC_APP_ORIGIN=http://localhost:5173
DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_PORT=1025
EMAIL_TIMEOUT=10
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false

# Native local file services; Compose uses the private S3 emulator internally.
FILES_STORAGE_BACKEND=local
FILES_S3_BUCKET=neu-lms-local
FILES_S3_REGION=ap-southeast-1
FILES_S3_ENDPOINT=http://127.0.0.1:59090
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CELERY_BROKER_URL=redis://127.0.0.1:56379/1
# For native S3-emulator use, configure AWS SDK credentials locally; never commit real credentials.

# B14 AI assistant: the same Google API key is used for Gemini embeddings and chat.
# Leave AI_API_KEY and AI_CHAT_MODEL empty to disable chat until configured.
AI_API_KEY=
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_CHAT_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=45
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_TIMEOUT_SECONDS=45
AI_RAG_TOP_K=5

# Auto-index uses the configured AI key; requires worker and beat.
AI_AUTO_INDEX_ENABLED=true
# Enable explicitly after verifying SMTP and choosing a timezone-aware cutoff.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_START_AT=
